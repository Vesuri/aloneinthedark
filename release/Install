; Alone in the Dark WHDLoad installation. Standard Commodore Installer V43 or newer.
; $VER: Install 1.0 (08.10.2026)
(set @app-name "Alone in the Dark")
(if (< @installer-version (* 43 65536))
  (abort "This installation requires Amiga Installer 43 or newer."))
(welcome)
(set #source (pathonly @icon))
(set @execute-dir #source)
; Same prerequisite check as the WHDLoad/Rescue on Fractalus install template.
(if (<> 0 (run "cd SYS:\nWhich WHDLoad >NIL:"))
  (abort "Install WHDLoad 17 or newer first. It must be accessible via the command path. See https://www.whdload.de/"))
(set #kick-ready 0)
(if (and (exists "Devs:Kickstarts/kick40068.A1200") (exists "Devs:Kickstarts/kick40068.A1200.RTB")) (set #kick-ready 1))
(if (and (exists "Devs:Kickstarts/kick40068.A4000") (exists "Devs:Kickstarts/kick40068.A4000.RTB")) (set #kick-ready 1))
(if (and (exists "Devs:Kickstarts/kick40063.A600") (exists "Devs:Kickstarts/kick40063.A600.RTB")) (set #kick-ready 1))
(if (<> (getassign "WHDCOMMON") "")
  ((if (and (exists "WHDCOMMON:kick40068.A1200") (exists "WHDCOMMON:kick40068.A1200.RTB")) (set #kick-ready 1))
   (if (and (exists "WHDCOMMON:kick40068.A4000") (exists "WHDCOMMON:kick40068.A4000.RTB")) (set #kick-ready 1))
   (if (and (exists "WHDCOMMON:kick40063.A600") (exists "WHDCOMMON:kick40063.A600.RTB")) (set #kick-ready 1))))
(if (= #kick-ready 0)
  (message "WHDLoad needs a Kickstart 3.1 image and matching .RTB file in Devs:Kickstarts or WHDCOMMON: before playing. See ReadMe for supported image names." (all)))
; RAM: is expandable: filesystem free blocks are not its available capacity.
; Resolve the device so T: and other assigns/subdrawers are handled too.
(procedure P_TempSpace
  (if (= (getdevice #temp) (getdevice "RAM:"))
    (- (+ (database "total-mem")) 6291456)
    (getdiskspace #temp)))
(set #parent
  (askdir
    (prompt "Where should Alone in the Dark be installed? A Alone in the Dark drawer will be created here.")
    (help "Choose a hard disk drawer with at least 8 MB free for the game and its original data.")
    (default @default-dest)))
(set #dest (tackon #parent "Alone in the Dark"))
(set #data (tackon #dest "data"))
(if (exists #dest)
  ((set #remove-existing
     (askbool
       (prompt ("The drawer \"%s\" already exists. Remove it, including saved games, before installing?" #dest))
       (help "Remove deletes the whole Alone in the Dark drawer, including saved games. Keep updates the installation in place.")
       (choices "Remove" "Keep")
       (default 0)))
   (if #remove-existing
     (delete #dest (all) (infos) (optional "force") (help @delete-help)))))
(set #install-data 1)
(if (and (= (exists (tackon #data "Alone In The Dark")) 1)
         (= (exists (tackon #data "Alone Data/ListBod2.PAK")) 1))
  (set #install-data
    (askbool
      (prompt "The original game data files are already installed. Reinstall them or use the existing files?")
      (help "Use existing skips the archive and temporary drawer questions. Reinstall extracts fresh data from your downloaded archive. Saved games are kept.")
      (choices "Reinstall" "Use existing")
      (default 0))))
(makedir #dest (infos) (help @makedir-help))
(makedir #data (help @makedir-help))
(complete 10)
(if #install-data
  (
    (set #temp
      (askdir
        (prompt "Select a temporary drawer with at least 24 MB free.")
        (help "Allow 24 MB free. T: normally uses RAM; choose a hard disk drawer if RAM is insufficient. Temporary files are removed when finished.")
        (default "T:")))
    (while (< (P_TempSpace) 25165824)
      ((message "The temporary drawer needs 24 MB free. Please select a hard disk drawer or free some space." (all))
       (set #temp
         (askdir
           (prompt "Select a temporary drawer with at least 24 MB free.")
           (help "Choose an existing hard disk drawer. Temporary files are removed when finished.")
           (default #temp)))))
    (set #archive
      (askfile
        (prompt "Select the downloaded AloneInTheDark.img_.sit archive.")
        (help "Choose AloneInTheDark.img_.sit downloaded from the Alone in the Dark page at Macintosh Repository. Leave it compressed.")
        (default "AloneInTheDark.img_.sit")))
    (if (= @pretend 0)
      ((working "Extracting and checking the game data. This may take several minutes. Temporary files are removed when finished.")
       ; Extract into a fresh drawer: the helper deliberately preserves existing
       ; originals. Publish replacements only after extraction has succeeded.
       (set #attempt 0)
       (set #stage (tackon #temp (".aitd-data-%ld" #attempt)))
       (while (exists #stage)
         ((set #attempt (+ #attempt 1))
          (set #stage (tackon #temp (".aitd-data-%ld" #attempt)))))
       (set #result
         (run ("\"%s\" \"%s\" \"%s\" \"%s\"" (tackon #source "AitdInstallData") #archive #stage #temp)))
       (if (<> #result 0)
         ((if (exists #stage) (delete #stage (all) (optional "force")))
          (abort "Original game data could not be installed. Check the archive and free disk space. Existing data files have not been replaced. See the helper's error message for details.")))
       (copyfiles (source #stage) (dest #data) (all) (help @copyfiles-help))
       (delete #stage (all) (optional "force"))))))
(makedir (tackon #dest "Saved Games") (help @makedir-help))
(makedir (tackon #dest "prefs") (help @makedir-help))
(complete 90)
(copyfiles (source (tackon #source "overlay.rsrc")) (dest #dest) (help @copyfiles-help))
(copyfiles
  (source (tackon #source "Alone"))
  (dest #dest)
  (help @copyfiles-help))
(copyfiles
  (source (tackon #source "AloneInTheDark.slave"))
  (dest #dest)
  (help @copyfiles-help))
(copyfiles
  (source (tackon #source "AloneInTheDark.inf"))
  (dest #dest)
  (newname "AloneInTheDark.info")
  (help @copyfiles-help))
; Keep these explicit, as in the WHDLoad install template.
(tooltype
  (dest (tackon #dest "AloneInTheDark"))
  (setdefaulttool "WHDLoad")
  (settooltype "Slave" "AloneInTheDark.slave")
  (settooltype "PreLoad" "")
  (setstack 10240)
  (noposition))
(copyfiles
  (source (tackon #source "ReadMe"))
  (dest #dest)
  (infos)
  (help @copyfiles-help))
(set @default-dest #dest)
(complete 100)
(exit)
